<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PiedPiper.app. build-app.sh replaces @VERSION@. The bundle identifier is a placeholder like the
  repository URL: change it (and keep it) once the project has its own domain.

  NSServices puts "Compress with PiedPiper" on any selection in the Finder and the two Extract
  commands on .pp files (Control-click > Quick Actions or Services). An NSRequiredContext entry
  makes macOS enable a service without the user switching it on first.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PiedPiper</string>
	<key>CFBundleExecutable</key>
	<string>PiedPiper</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.piedpiper.archiver</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PiedPiper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License. Third-party notices are in Contents/Resources/Licenses.</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PiedPiper archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleTypeIconFile</key>
			<string>ArchiveIcon</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.piedpiper.archive</string>
			</array>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.piedpiper.archive</string>
			<key>UTTypeDescription</key>
			<string>PiedPiper archive</string>
			<key>UTTypeIconFile</key>
			<string>ArchiveIcon</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pp</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-piedpiper</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Compress with PiedPiper</string>
			</dict>
			<key>NSMessage</key>
			<string>compressFiles</string>
			<key>NSPortName</key>
			<string>PiedPiper</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Extract Here with PiedPiper</string>
			</dict>
			<key>NSMessage</key>
			<string>extractHere</string>
			<key>NSPortName</key>
			<string>PiedPiper</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>com.piedpiper.archive</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Extract to Folder with PiedPiper</string>
			</dict>
			<key>NSMessage</key>
			<string>extractToFolder</string>
			<key>NSPortName</key>
			<string>PiedPiper</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>com.piedpiper.archive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
