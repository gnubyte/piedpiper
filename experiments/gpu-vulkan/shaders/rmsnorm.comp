#version 450
#include "common.glsl"
// model.rs rmsnorm_fwd, one workgroup per row r = r0 + group:
// rinv = rms_inv(x); xh = x * rinv; y = g * xh.
// push: 0 r0, 1 d, 2 x, 3 g, 4 xh, 5 y, 6 rinv
layout(local_size_x = 64) in;
shared float s_r;
void main() {
    uint r = P(0) + gl_WorkGroupID.x, d = P(1);
    uint x = P(2) + r * d;
    if (gl_LocalInvocationID.x == 0u) {
        float ri = rms_inv(x, d);
        s_r = ri;
        F[P(6) + r] = ri;
    }
    barrier();
    float ri = s_r;
    for (uint i = gl_LocalInvocationID.x; i < d; i += 64u) {
        PRECISE float v = F[x + i] * ri;
        F[P(4) + r * d + i] = v;
        PRECISE float yv = F[P(3) + i] * v;
        F[P(5) + r * d + i] = yv;
    }
}
