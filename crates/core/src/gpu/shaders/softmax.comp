#version 450
#include "common.glsl"
// model.rs softmax over one row per workgroup (vocab <= 4096, staged in shared memory):
// max starting from v[0] (computed in parallel: a NaN never wins `x > m`, a NaN v[0] is kept,
// and the sign of a zero max cancels in x - m), exp of the clamped shift, the 8-lane sum of
// kernels.rs sum_v, then multiplication by the reciprocal.
// push: 0 r0, 1 v, 2 probs
layout(local_size_x = 64) in;
shared float sv[4096];
shared float s_red[64];
shared float s_lane[8];
shared float s_val;
void main() {
    uint v = P(1);
    uint row = P(2) + (P(0) + gl_WorkGroupID.x) * v;
    uint lid = gl_LocalInvocationID.x;
    float lmax = uintBitsToFloat(0xFF800000u);
    for (uint i = lid; i < v; i += 64u) {
        float x = F[row + i];
        sv[i] = x;
        if (x > lmax) lmax = x;
    }
    s_red[lid] = lmax;
    barrier();
    if (lid == 0u) {
        float m = sv[0];
        if (!isnan(m)) {
            for (uint i = 0u; i < 64u; i++) {
                if (s_red[i] > m) m = s_red[i];
            }
        }
        s_val = m;
    }
    barrier();
    float m = s_val;
    for (uint i = lid; i < v; i += 64u) {
        PRECISE float z = sv[i] - m;
        if (z < C_EXP_FLOOR) z = C_EXP_FLOOR;
        sv[i] = pp_exp(z);
    }
    barrier();
    uint chunks = v / 8u;
    if (lid < 8u) {
        PRECISE float acc = 0.0;
        for (uint c = 0u; c < chunks; c++) acc = acc + sv[c * 8u + lid];
        s_lane[lid] = acc;
    }
    barrier();
    if (lid == 0u) {
        PRECISE float s = ((s_lane[0] + s_lane[4]) + (s_lane[1] + s_lane[5])) + ((s_lane[2] + s_lane[6]) + (s_lane[3] + s_lane[7]));
        for (uint i = chunks * 8u; i < v; i++) s = s + sv[i];
        s_val = f32_div(1.0, s);
    }
    barrier();
    float inv = s_val;
    for (uint i = lid; i < v; i += 64u) {
        PRECISE float x = sv[i] * inv;
        F[row + i] = x;
    }
}
