#version 450
#include "common.glsl"
// matmul_nt.comp with 16x16 output tiles and one output per thread (8 lane accumulators in
// two vec4s), for small grids. Per-element arithmetic is identical to kernels.rs matmul_nt.
// push: 0 M, 1 N, 2 K, 3 a, 4 b, 5 y
layout(local_size_x = 16, local_size_y = 16) in;
const uint TS = 16u;
const uint BK = 16u; // a multiple of 8
shared float As[TS][BK + 1u];
shared float Bs[TS][BK + 1u];

void main() {
    uint M = P(0), N = P(1), K = P(2), a = P(3), b = P(4), y = P(5);
    uint K8 = K / 8u * 8u;
    uint i0 = gl_WorkGroupID.y * TS, j0 = gl_WorkGroupID.x * TS;
    uint tx = gl_LocalInvocationID.x, ty = gl_LocalInvocationID.y;
    uint e = ty * 16u + tx;
    PRECISE vec4 lo = vec4(0.0), hi = vec4(0.0);
    for (uint k0 = 0u; k0 < K8; k0 += BK) {
        uint kn = min(BK, K8 - k0);
        uint ii = e / BK, tt = e % BK;
        float v = 0.0, w = 0.0;
        if (tt < kn) {
            if (i0 + ii < M) v = F[a + (i0 + ii) * K + k0 + tt];
            if (j0 + ii < N) w = F[b + (j0 + ii) * K + k0 + tt];
        }
        As[ii][tt] = v;
        Bs[ii][tt] = w;
        barrier();
        for (uint c = 0u; c < kn; c += 8u) {
            vec4 al = vec4(As[ty][c], As[ty][c + 1u], As[ty][c + 2u], As[ty][c + 3u]);
            vec4 ah = vec4(As[ty][c + 4u], As[ty][c + 5u], As[ty][c + 6u], As[ty][c + 7u]);
            vec4 bl = vec4(Bs[tx][c], Bs[tx][c + 1u], Bs[tx][c + 2u], Bs[tx][c + 3u]);
            vec4 bh = vec4(Bs[tx][c + 4u], Bs[tx][c + 5u], Bs[tx][c + 6u], Bs[tx][c + 7u]);
            lo = lo + al * bl;
            hi = hi + ah * bh;
        }
        barrier();
    }
    uint i = i0 + ty, j = j0 + tx;
    if (i < M && j < N) {
        PRECISE vec4 u = lo + hi;
        PRECISE float s = (u.x + u.y) + (u.z + u.w);
        for (uint t = K8; t < K; t++) s = s + F[a + i * K + t] * F[b + j * K + t];
        F[y + i * N + j] = s;
    }
}
